{
  "manifest_version": 3,
  "name": "Color Picker: Eyedropper & Contrast",
  "version": "1.0.0",
  "description": "Eyedropper color picker: copy HEX, RGB, HSL, HSV or CMYK and check WCAG contrast. Works offline; nothing leaves your device.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Color Picker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "clipboardWrite"
  ]
}
